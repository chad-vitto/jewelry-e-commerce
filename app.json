{
  "expo": {
    "name": "ReLoved Gold Collections",
    "slug": "reloved-gold-collections",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-rings.png",
    "scheme": "relovedgold",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.reloved.gold"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-image",
      "expo-status-bar",
      "expo-splash-screen",
      "expo-notifications",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6b329c25-4294-4b51-afa4-cbb3cb5febb7"
      }
    },
    "owner": "chadvitto",
    "android": {
      "package": "com.reloved.gold",
      "googleServicesFile": "./google-services.json",
      "userInterfaceStyle": "automatic"
    }
  }
}